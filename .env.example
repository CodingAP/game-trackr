# Copy this file to .env and fill in the values you need. Every setting is optional.

# Secret used to sign sign-in tokens. Strongly recommended in production:
# without it a random secret is generated on each start, so everyone is signed
# out whenever the server restarts. Use a long random string, e.g.
#   openssl rand -hex 32
# AUTH_TOKEN_SECRET=

# MobyGames integration (cover art, descriptions, platforms).
# Get a key at https://www.mobygames.com/info/api/
# MOBYGAMES_API_KEY=
# Refresh cached MobyGames info after this many hours (default 168 = 7 days).
# MOBYGAMES_CACHE_TTL_HOURS=168

# RetroAchievements integration (link games to achievement sets in the editor).
# Get a web API key from your RetroAchievements settings page.
# RETROACHIEVEMENTS_API_KEY=

# Port the server listens on (default 3000).
# PORT=3000
